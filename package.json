{
  "name": "dsh-input-limit",
  "version": "0.1.1",
  "description": "Set the current model's input limit (context window) directly from the dsh web composer.",
  "author": "viyu-tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viyu-tech/dsh-input-limit.git"
  },
  "bugs": {
    "url": "https://github.com/viyu-tech/dsh-input-limit/issues"
  },
  "homepage": "https://github.com/viyu-tech/dsh-input-limit#readme",
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context-window",
    "input-limit",
    "tokens"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@types/react": "^18.3.31",
    "lightningcss": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
